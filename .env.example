# Copy to .env.local for local development.
# On production, set the same names in your host's environment settings.

CONTENT_API_URL=https://your-api-host.example/api/content
CONTENT_API_CODE=your_content_api_code_here

CONTACT_API_URL=https://your-api-host.example/api/contact
CONTACT_API_CODE=your_contact_api_code_here

