# =============================================================================
# HIGH RISK — secrets, deploy helpers, local docs (never commit)
# =============================================================================

# API keys / environment (only .env.example is safe to share — placeholders only)
.env
.env.*
!.env.example

# Deploy scripts and files that may embed Azure Function codes or subscription IDs
/scripts/
scripts/envvars
scripts/syncazure.json
scripts/*.sh

# Local documentation (deploy steps, infra names, domain/DNS notes)
/docs/
*.md
*.txt

# Azure deploy artifacts (may bundle .env or server files)
.azure-deploy/
deploy.zip
deploy-fe.zip
*.zip

# Keys and credential-like filenames
*.pem
*credentials*
*secrets*

# =============================================================================
# dependencies
# =============================================================================
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
