# =============================================================================
# HIGH RISK — never commit (secrets, deploy, local infra notes)
# =============================================================================

# Environment — real keys live in .env.local / host settings only
.env
.env.*
!.env.example

# Local deploy helpers (API codes, Azure CLI, subscription IDs)
/scripts/

# Private docs (deploy, DNS, domain — may name resources)
/docs/

# Cursor / agent notes (not project docs)
AGENTS.md
CLAUDE.md

# =============================================================================
# SAFE TO COMMIT (explicit allowlist via negation)
# =============================================================================
# README.md        — setup only, no secrets (see !README.md below)
# .env.example     — variable names + placeholders only

*.md
!README.md

# =============================================================================
# Deploy artifacts & keys
# =============================================================================
.azure-deploy/
deploy.zip
deploy-fe.zip
*.pem

# =============================================================================
# dependencies
# =============================================================================
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
